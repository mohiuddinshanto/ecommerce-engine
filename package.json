{
  "name": "store-app",
  "private": true,
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore \".next/**\" --ignore \"app/**\" --ignore \"components/**\" --ignore \"lib/**\" --ignore \"public/**\" server.js --dev",
    "build": "prisma generate && npm run build:api && npm run migrate:deploy && next build && npm run seed:store:prod:empty",
    "build:api": "tsc -p tsconfig.server.json",
    "start": "node server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "deploy": "npm run build",
    "seed": "tsx api/seed.ts",
    "seed:store": "tsx api/seed-store.ts",
    "seed:store:prod": "node dist/seed-store.js",
    "seed:store:prod:empty": "node dist/seed-store.js --if-empty",
    "export:store": "tsx api/export-store.ts",
    "test:admin": "tsx api/test-admin.ts",
    "reset-password": "tsx api/reset-password.ts",
    "reset-password:prod": "node dist/reset-password.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "migrate:deploy": "node scripts/migrate-deploy.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "smoke": "node scripts/smoke.mjs",
    "prisma:studio": "prisma studio",
    "optimize:images": "tsx scripts/optimize-existing-images.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@heroui/react": "^2.8.4",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "framer-motion": "^12.23.24",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "mysql2": "^3.24.5",
    "next": "^15.5.2",
    "nodemailer": "^10.0.9",
    "prisma": "^6.16.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0",
    "swiper": "^14.2.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "browserslist": [
    "Chrome >= 111",
    "Firefox >= 113",
    "Safari >= 16.4",
    "Edge >= 111",
    "not dead",
    "not IE 11"
  ]
}
